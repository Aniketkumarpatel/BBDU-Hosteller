# ==============================================================================
# BBDU HOSTELLER - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ----- Server Configuration -----
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ----- MongoDB Database Configuration -----
# Local example:    mongodb://127.0.0.1:27017/bbdu_hosteller
# Atlas example:    mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/bbdu_hosteller
MONGODB_URI=mongodb://127.0.0.1:27017/bbdu_hosteller

# Test Database (Automated tests create and drop isolated collections)
TEST_MONGODB_URI=mongodb://127.0.0.1:27017/bbdu_hosteller_test

# ----- Authentication & JWT Security -----
# 256-bit cryptographic secret for signing JSON Web Tokens
JWT_SECRET=your_ultra_secure_jwt_secret_key_at_least_32_chars_long
JWT_EXPIRES_IN=24h

# ----- AI Command Center Configuration (Optional Provider Extensions) -----
AI_PROVIDER=local_deterministic
# GEMINI_API_KEY=your_gemini_api_key_here

# ----- Pilot Gating (DEC-020) -----
# MUST be 'true' on any deployment that serves real pilot users (Go-Live Gate item 6).
# true : no automatic escalation or reassignment, SLA breaches notify the hostel's
#        wardens only, jobs of deferred modules (maintenance, cleaning, outpass,
#        asset, finance) are skipped.
# false: full platform behavior, including the Staff > Warden > Authority escalation chain.
# Anything other than the exact string 'true' is treated as false. The server logs the
# active mode at startup.
PILOT_MODE=false
